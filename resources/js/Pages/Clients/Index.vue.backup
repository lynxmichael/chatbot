<script setup>
import { Head, Link, router } from "@inertiajs/vue3";
import AuthenticatedLayout from "@/Layouts/AuthenticatedLayout.vue";
import { ref, watch } from "vue";

const props = defineProps({
  clients: {
    type: Object,
    required: true,
  },
  filters: {
    type: Object,
    default: () => ({
      search: "",
    }),
  },
});

const search = ref(props.filters.search || "");

let timeout = null;

watch(search, (value) => {
  clearTimeout(timeout);

  timeout = setTimeout(() => {
    router.get(
      route("clients.index"),
      {
        search: value,
      },
      {
        preserveState: true,
        preserveScroll: true,
        replace: true,
      },
    );
  }, 300);
});

const deleteClient = (client) => {
  if (
    confirm(
      `Voulez-vous vraiment supprimer ${client.first_name} ${client.last_name} ?`,
    )
  ) {
    router.delete(route("clients.destroy", client.id), {
      preserveScroll: true,
    });
  }
};
</script>

<template>
  <Head title="Clients" />

  <AuthenticatedLayout>
    <template #header>
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold leading-tight text-gray-800">
          Clients
        </h2>

        <Link
          :href="route('clients.create')"
          class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700"
        >
          + Nouveau client
        </Link>
      </div>
    </template>

    <div class="py-8">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Message de succès -->
        <div
          v-if="$page.props.flash?.success"
          class="mb-6 rounded-md bg-green-50 p-4 text-sm text-green-700"
        >
          {{ $page.props.flash.success }}
        </div>

        <!-- Recherche -->
        <div class="mb-6 rounded-lg bg-white p-4 shadow">
          <label
            for="search"
            class="mb-2 block text-sm font-medium text-gray-700"
          >
            Rechercher un client
          </label>

          <input
            id="search"
            v-model="search"
            type="text"
            placeholder="Nom, téléphone, email ou entreprise..."
            class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>

        <!-- Tableau -->
        <div class="overflow-hidden rounded-lg bg-white shadow">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th
                    class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                  >
                    Client
                  </th>

                  <th
                    class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                  >
                    Téléphone
                  </th>

                  <th
                    class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                  >
                    Email
                  </th>

                  <th
                    class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                  >
                    Entreprise
                  </th>

                  <th
                    class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500"
                  >
                    Statut
                  </th>

                  <th
                    class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500"
                  >
                    Actions
                  </th>
                </tr>
              </thead>

              <tbody class="divide-y divide-gray-200 bg-white">
                <tr
                  v-for="client in clients.data"
                  :key="client.id"
                  class="hover:bg-gray-50"
                >
                  <td class="whitespace-nowrap px-6 py-4">
                    <div class="font-medium text-gray-900">
                      {{ client.first_name }}
                      {{ client.last_name }}
                    </div>
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                    {{ client.phone }}
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                    {{ client.email || "—" }}
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                    {{ client.company || "—" }}
                  </td>

                  <td class="whitespace-nowrap px-6 py-4">
                    <span
                      class="inline-flex rounded-full px-2 py-1 text-xs font-semibold"
                      :class="{
                        'bg-green-100 text-green-800':
                          client.status === 'active',
                        'bg-gray-100 text-gray-800':
                          client.status === 'inactive',
                        'bg-red-100 text-red-800': client.status === 'blocked',
                      }"
                    >
                      {{
                        client.status === "active"
                          ? "Actif"
                          : client.status === "inactive"
                            ? "Inactif"
                            : "Bloqué"
                      }}
                    </span>
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                    <Link
                      :href="route('clients.show', client.id)"
                      class="mr-3 font-medium text-indigo-600 hover:text-indigo-900"
                    >
                      Voir
                    </Link>

                    <Link
                      :href="route('clients.edit', client.id)"
                      class="mr-3 font-medium text-blue-600 hover:text-blue-900"
                    >
                      Modifier
                    </Link>

                    <button
                      type="button"
                      @click="deleteClient(client)"
                      class="font-medium text-red-600 hover:text-red-900"
                    >
                      Supprimer
                    </button>
                  </td>
                </tr>

                <!-- Aucun client -->
                <tr v-if="clients.data.length === 0">
                  <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                    Aucun client trouvé.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div
            v-if="clients.links?.length > 3"
            class="flex flex-wrap gap-2 border-t border-gray-200 px-6 py-4"
          >
            <template v-for="(link, index) in clients.links" :key="index">
              <Link
                v-if="link.url"
                :href="link.url"
                v-html="link.label"
                class="rounded-md border px-3 py-2 text-sm"
                :class="{
                  'bg-indigo-600 text-white': link.active,
                  'bg-white text-gray-700 hover:bg-gray-50': !link.active,
                }"
                preserve-scroll
              />

              <span
                v-else
                v-html="link.label"
                class="rounded-md border px-3 py-2 text-sm text-gray-400"
              />
            </template>
          </div>
        </div>
      </div>
    </div>
  </AuthenticatedLayout>
</template>
